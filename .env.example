# Servidor
PORT=3000
NODE_ENV=development
SESSION_SECRET=berryhealth_secret_key_change_in_production

# Banco de Dados
# Defina DB_DIALECT como 'sqlite' para desenvolvimento local simplificado ou 'mysql' para MySQL
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# Configurações para MySQL (usadas apenas se DB_DIALECT=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=berryhealth_db
DB_USER=root
DB_PASS=
