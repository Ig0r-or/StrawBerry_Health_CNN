# ==============================================================================
# 🍓 BERRYHEALTH AI - VARIÁVEIS DE CONFIGURAÇÃO DE AMBIENTE (.env.example)
# UNIVÁS - Pouso Alegre, MG · Engenharia de Software
# ==============================================================================

# Configurações do Servidor
PORT=3000
NODE_ENV=development

# Chave Secreta para Sessão (substitua por uma chave forte em produção)
SESSION_SECRET=coloque_aqui_uma_chave_secreta_longa_e_segura

# ------------------------------------------------------------------------------
# Banco de Dados
# 'sqlite' (desenvolvimento ágil sem instalar nada) ou 'mysql'
# ------------------------------------------------------------------------------
DB_DIALECT=sqlite
DB_STORAGE=./database.sqlite

# Configurações para MySQL (usadas apenas se DB_DIALECT=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=berryhealth_prod_db
DB_USER=berry_admin
DB_PASS=sua_senha_mysql_aqui

# Informações da Aplicação
APP_NAME="BerryHealth AI"
APP_REGION="Sul de Minas - Mantiqueira"
