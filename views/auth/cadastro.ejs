<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="main-content" style="max-width: 520px; margin-top: 30px;">
  <%- include('../partials/flash') %>

  <div class="card">
    <div style="text-align: center; margin-bottom: 24px;">
      <span style="font-size: 42px;">🍓</span>
      <h1 style="font-size: 24px; margin: 8px 0 4px; color: var(--ink);">Cadastro de Produtor</h1>
      <p style="color: var(--mut); margin: 0; font-size: 14px;">Crie sua conta para monitorar a saúde da sua lavoura de morangueiro.</p>
    </div>

    <form action="/cadastro" method="POST">
      <div class="form-group">
        <label for="nome" class="form-label">Nome Completo *</label>
        <input type="text" id="nome" name="nome" class="form-control" placeholder="Ex.: Cezar Vitor" required autofocus>
      </div>

      <div class="form-group">
        <label for="email" class="form-label">E-mail *</label>
        <input type="email" id="email" name="email" class="form-control" placeholder="produtor@email.com" required>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="cidade" class="form-label">Cidade</label>
          <input type="text" id="cidade" name="cidade" class="form-control" value="Pouso Alegre">
        </div>
        <div class="form-group">
          <label for="estado" class="form-label">Estado</label>
          <input type="text" id="estado" name="estado" class="form-control" value="MG" maxlength="2">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="senha" class="form-label">Senha * (mínimo 6 caracteres)</label>
          <input type="password" id="senha" name="senha" class="form-control" placeholder="••••••••" minlength="6" required>
        </div>
        <div class="form-group">
          <label for="confirmacao_senha" class="form-label">Confirme a Senha *</label>
          <input type="password" id="confirmacao_senha" name="confirmacao_senha" class="form-control" placeholder="••••••••" minlength="6" required>
        </div>
      </div>

      <button type="submit" class="btn" style="width: 100%; margin-top: 10px;">
        Concluir Cadastro
      </button>
    </form>

    <div style="margin-top: 20px; text-align: center; font-size: 14px;">
      <p style="margin: 0; color: var(--mut);">Já tem cadastro? <a href="/login">Clique aqui para entrar</a></p>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
