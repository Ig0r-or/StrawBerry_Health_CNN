<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="main-content" style="max-width: 480px; margin-top: 40px;">
  <%- include('../partials/flash') %>

  <div class="card">
    <div style="text-align: center; margin-bottom: 24px;">
      <span style="font-size: 42px;">🍓</span>
      <h1 style="font-size: 24px; margin: 8px 0 4px; color: var(--ink);">Acesso ao Sistema</h1>
      <p style="color: var(--mut); margin: 0; font-size: 14px;">Entre com seu e-mail e senha para gerenciar seus talhões e diagnósticos.</p>
    </div>

    <form action="/login" method="POST">
      <div class="form-group">
        <label for="email" class="form-label">E-mail</label>
        <input type="email" id="email" name="email" class="form-control" placeholder="exemplo@produtor.com" required autofocus>
      </div>

      <div class="form-group">
        <label for="senha" class="form-label">Senha</label>
        <input type="password" id="senha" name="senha" class="form-control" placeholder="••••••••" required>
      </div>

      <button type="submit" class="btn" style="width: 100%; margin-top: 8px;">
        Entrar no BerryHealth
      </button>
    </form>

    <div style="margin-top: 24px; padding-top: 16px; border-top: 1px solid var(--border); text-align: center; font-size: 14px;">
      <p style="margin: 0 0 12px; color: var(--mut);">Ainda não possui conta?</p>
      <a href="/cadastro" class="btn btn-secondary" style="width: 100%;">Criar Conta de Produtor</a>
    </div>

    <div style="margin-top: 20px; background: #fff8e1; border: 1px solid #ffe082; border-radius: 10px; padding: 12px; font-size: 12px; color: #795548;">
      <b>🌱 Demonstração / Avaliação:</b><br>
      • <b>Admin:</b> admin@berryhealth.com | <code>admin123</code><br>
      • <b>Produtor:</b> produtor@berryhealth.com | <code>produtor123</code>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
