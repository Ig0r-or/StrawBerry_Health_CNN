<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="main-content" style="max-width: 680px;">
  <%- include('../partials/flash') %>

  <div style="margin-bottom: 20px;">
    <a href="/locais" style="font-size: 14px; font-weight: 600;">← Voltar para Locais de Plantio</a>
  </div>

  <div class="card">
    <h1 style="font-size: 22px; margin: 0 0 6px; color: var(--ink);">Novo Local de Plantio / Talhão</h1>
    <p style="color: var(--mut); margin: 0 0 20px; font-size: 14px;">Preencha os dados do talhão ou estufa de morango.</p>

    <form action="/locais" method="POST">
      <div class="form-group">
        <label for="nome" class="form-label">Nome do Talhão / Local *</label>
        <input type="text" id="nome" name="nome" class="form-control" placeholder="Ex.: Estufa 01 - Mudas Novas" value="<%= local.nome || '' %>" required autofocus>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="cultivar" class="form-label">Cultivar / Variedade</label>
          <input type="text" id="cultivar" name="cultivar" class="form-control" placeholder="Ex.: San Andreas, Albion, Camino Real" value="<%= local.cultivar || 'San Andreas' %>">
        </div>
        <div class="form-group">
          <label for="area_hectares" class="form-label">Área Estimada (hectares)</label>
          <input type="number" step="0.01" id="area_hectares" name="area_hectares" class="form-control" placeholder="0.50" value="<%= local.area_hectares || '0.50' %>">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="cep" class="form-label">CEP</label>
          <input type="text" id="cep" name="cep" class="form-control" placeholder="37550-000" value="<%= local.cep || '' %>">
        </div>
        <div class="form-group">
          <label for="cidade" class="form-label">Cidade *</label>
          <input type="text" id="cidade" name="cidade" class="form-control" value="<%= local.cidade || 'Pouso Alegre' %>" required>
        </div>
        <div class="form-group">
          <label for="estado" class="form-label">Estado *</label>
          <input type="text" id="estado" name="estado" class="form-control" value="<%= local.estado || 'MG' %>" maxlength="2" required>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="latitude" class="form-label">Latitude (opcional)</label>
          <input type="number" step="any" id="latitude" name="latitude" class="form-control" placeholder="-22.2301" value="<%= local.latitude || '' %>">
        </div>
        <div class="form-group">
          <label for="longitude" class="form-label">Longitude (opcional)</label>
          <input type="number" step="any" id="longitude" name="longitude" class="form-control" placeholder="-45.9347" value="<%= local.longitude || '' %>">
        </div>
      </div>

      <div class="form-group">
        <label for="observacoes" class="form-label">Observações sobre o cultivo</label>
        <textarea id="observacoes" name="observacoes" rows="3" class="form-control" placeholder="Ex.: Substrato em bancada suspensa com fertirrigação por gotejamento..."><%= local.observacoes || '' %></textarea>
      </div>

      <div style="display: flex; gap: 12px; margin-top: 24px;">
        <button type="submit" class="btn" style="flex: 1;">Salvar Local de Plantio</button>
        <a href="/locais" class="btn btn-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
