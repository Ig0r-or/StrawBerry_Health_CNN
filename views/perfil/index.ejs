<%- include('../partials/head') %>
<%- include('../partials/navbar') %>

<main class="main-content" style="max-width: 620px;">
  <%- include('../partials/flash') %>

  <div class="card">
    <div style="display: flex; align-items: center; gap: 16px; margin-bottom: 24px; padding-bottom: 18px; border-bottom: 1px solid var(--border);">
      <div class="avatar-circle" style="width: 56px; height: 56px; font-size: 20px;">
        <%= usuario.nome.substring(0, 2).toUpperCase() %>
      </div>
      <div>
        <h1 style="font-size: 22px; margin: 0 0 4px; color: var(--ink);"><%= usuario.nome %></h1>
        <p style="margin: 0; color: var(--mut); font-size: 14px;"><%= usuario.email %></p>
        <span class="badge-tag <%= usuario.perfil === 'admin' ? 'badge-admin' : 'badge-produtor' %>" style="margin-top: 6px; display: inline-block;">
          Perfil: <%= usuario.perfil === 'admin' ? 'Administrador' : 'Produtor Rural' %>
        </span>
      </div>
    </div>

    <h2 class="card-title" style="font-size: 16px;">Editar Dados do Perfil</h2>
    <form action="/perfil" method="POST">
      <div class="form-group">
        <label for="nome" class="form-label">Nome Completo *</label>
        <input type="text" id="nome" name="nome" class="form-control" value="<%= usuario.nome %>" required>
      </div>

      <div class="form-group">
        <label for="email" class="form-label">E-mail (fixo)</label>
        <input type="email" id="email" class="form-control" value="<%= usuario.email %>" disabled style="background: #f5f5f5;">
      </div>

      <div class="form-group">
        <label for="telefone" class="form-label">Telefone / WhatsApp</label>
        <input type="text" id="telefone" name="telefone" class="form-control" placeholder="(35) 99999-9999" value="<%= usuario.telefone || '' %>">
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="cidade" class="form-label">Cidade</label>
          <input type="text" id="cidade" name="cidade" class="form-control" value="<%= usuario.cidade || 'Pouso Alegre' %>">
        </div>
        <div class="form-group">
          <label for="estado" class="form-label">Estado</label>
          <input type="text" id="estado" name="estado" class="form-control" value="<%= usuario.estado || 'MG' %>" maxlength="2">
        </div>
      </div>

      <button type="submit" class="btn" style="width: 100%; margin-top: 10px;">
        Atualizar Dados
      </button>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
